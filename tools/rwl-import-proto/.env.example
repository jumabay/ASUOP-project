# Copy outside Git, then:
#   gradlew.bat run --args="--dry-run --env-file=PATH --save-dir=%USERPROFILE%\rwl-captures"
# Java does NOT auto-load .env.

RWL_NAME=
RWL_PASSWORD=
RWL_VAGON_NOS=
# RWL_BASE_URL=https://www.railwagonlocation.com/xml/export.php

# New primary database RAILDB (not RAC.WORLD archive)
# Example only — use actual host/port/service from DBA after RAILDB exists:
RAILDB_JDBC_URL=jdbc:oracle:thin:@//HOST:1521/RAILDB.WORLD
# Intended schema inside RAILDB per ADR-0009: RAIL_APP (confirm in local config)
RAILDB_USER=RAIL_APP
RAILDB_PASSWORD=

# Optional identity pin (recommended)
EXPECTED_ORACLE_SERVICE=RAILDB_SERVICE
EXPECTED_ORACLE_DB_NAME=RAILDB

# Aliases also accepted: ORACLE_JDBC_URL / ORACLE_USER / ORACLE_PASSWORD
